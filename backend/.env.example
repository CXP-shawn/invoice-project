PORT=3001
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=invoice_db

# Qwen 视觉/全模态模型（可选，配置后优先使用，识别更精准）
# 在 https://bailian.console.aliyun.com/ 获取 API Key
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 主模型：omni 全模态会自动走流式调用；也可填 qwen3.7-plus / qwen-vl-ocr-latest 等
# QWEN_VL_MODEL=qwen3.5-omni-plus
# 主模型失败时的兜底模型
# QWEN_FALLBACK_MODEL=qwen-vl-ocr-latest
